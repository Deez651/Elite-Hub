-- === BUTTON LOGIC ===
FlingButton.MouseButton1Click:Connect(function()
    flingEnabled = not flingEnabled
    
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if flingEnabled then
        FlingButton.Text = "✅ TOUCH FLING: ON"
        local tween = TweenService:Create(FlingButton, tweenInfo, {
            BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        })
        tween:Play()
        startFling()
    else
        FlingButton.Text = "🚫 TOUCH FLING: OFF"
        local tween = TweenService:Create(FlingButton, tweenInfo, {
            BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        })
        tween:Play()
        if flingConn then
            flingConn:Disconnect()
            flingConn = nil
        end
    end
end)

WaveButton.MouseButton1Click:Connect(function()
    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween1 = TweenService:Create(WaveButton, tweenInfo, {
        BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    })
    tween1:Play()
    
    playWave()
    
    task.wait(0.3)
    local tween2 = TweenService:Create(WaveButton, tweenInfo, {
        BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    })
    tween2:Play()
end)

